# Copie este arquivo para ".env" e ajuste os valores.
# Com DATABASE_URL o sistema usa PostgreSQL; sem ela (linha comentada), usa SQLite em data/hypecards.db.
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/hypecards

# Opcional: porta do servidor (padrão 3000)
# PORT=3000

# Opcional: senha do usuário "admin" criado no primeiro uso (padrão admin123)
# ADMIN_SENHA_INICIAL=admin123

# Opcional: caminho do pg_dump usado no backup (detectado automaticamente no Windows)
# PG_DUMP=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
